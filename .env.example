# Copy to backend/.env for local development. Never commit real secrets.

DATABASE_URL=sqlite:///./challenge_to_impact.db
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRE_MINUTES=480
JWT_REFRESH_EXPIRE_MINUTES=10080
UPLOAD_DIR=./uploads
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
OPENAI_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
DEMO_MODE=true
MAX_UPLOAD_MB=25
